    "@types/lodash.merge": "^4.6.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.8.8",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "lodash.merge": "^4.6.2",
    "morgan": "^1.10.0",
    "prisma": "^5.6.0",
    "typescript": "^5.2.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1"
