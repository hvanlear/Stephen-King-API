<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-JF9VSP0JWE"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-JF9VSP0JWE");
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="https://use.typekit.net/smb2swj.css" />
    <title>Login — Stephen King API Dashboard</title>
  </head>
  <body>
    <div class="docs-container">
      <div class="docs-content">
        <div class="docs-header">
          <a class="docs-back-link" href="/">&larr; Back to Home</a>
          <div class="docs-banner">
            <span class="sk docs-title"
              ><div>Stephen</div>
              <div>King</div></span
            >
            <h1 class="red sk-sub docs-subtitle">Dashboard</h1>
          </div>
        </div>

        <div class="login-form">
          <% if (error) { %>
          <p class="login-error"><%= error %></p>
          <% } %>
          <form method="POST" action="/dashboard/login">
            <label for="password">Password</label>
            <input
              type="password"
              id="password"
              name="password"
              placeholder="Enter dashboard password"
              required
            />
            <button type="submit">Log In</button>
          </form>
        </div>
      </div>
    </div>
  </body>
</html>
