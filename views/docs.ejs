          <h3>Villain</h3>
          <table class="docs-table">
            <thead>
              <tr>
                <th>Field</th>
                <th>Type</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>id</code></td>
                <td>integer</td>
                <td>Unique identifier</td>
              </tr>
              <tr>
                <td><code>name</code></td>
                <td>string</td>
                <td>Villain name</td>
              </tr>
              <tr>
                <td><code>gender</code></td>
                <td>string?</td>
