        <!-- Introduction -->
        <section id="introduction" class="docs-section">
          <h2>Introduction</h2>
          <p>
            The Stephen King API is a free, open-source REST API providing data about Stephen King's novels, short stories, villains, places, and the types of villain. No authentication is required. All endpoints are read-only (<code>GET</code> requests only).
          </p>
          <p>
            Responses are returned in JSON format. Related resources include links to their associated endpoints for easy traversal.
          </p>
        </section>

        <!-- Base URL -->
        <section id="base-url" class="docs-section">
          <h2>Base URL</h2>
          <div class="docs-code-block">
            <code><%= url %>/api</code>
          </div>
          <p>All endpoints described below are relative to this base URL.</p>
        </section>

        <!-- Pagination -->
        <section id="pagination" class="docs-section">
          <h2>Pagination</h2>
          <p>
            All list endpoints support optional pagination via query parameters:
          </p>
          <table class="docs-table">
            <thead>
              <tr>
                <th>Parameter</th>
                <th>Type</th>
                <th>Description</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>page</code></td>
                <td>integer</td>
                <td>Page number (starts at 1)</td>
              </tr>
              <tr>
                <td><code>limit</code></td>
                <td>integer</td>
                <td>Items per page (max 100)</td>
              </tr>
            </tbody>
          </table>
          <p>
            Both <code>page</code> and <code>limit</code> must be provided together to enable pagination. Without them, all results are returned. Values that aren't whole numbers return a <a href="#errors">400 error</a>.
          </p>
          <h3>Without pagination</h3>
          <div class="docs-code-block">
            <code>GET <%= url %>/api/books</code>
          </div>
          <pre class="docs-json">{
  "data": [ ... ]
}</pre>
          <h3>With pagination</h3>
          <div class="docs-code-block">
            <code>GET <%= url %>/api/books?page=1&limit=5</code>
          </div>
          <pre class="docs-json">{
  "data": [ ... ],
  "pagination": {
    "page": 1,
    "limit": 5,
    "total": 68,
    "totalPages": 14
  }
}</pre>
        </section>

        <!-- Errors -->
        <section id="errors" class="docs-section">
          <h2>Errors</h2>
          <p>
            Errors are returned as JSON with an HTTP status code and an <code>error</code> message:
          </p>
          <pre class="docs-json">{
  "error": "Villain not found"
}</pre>
          <table class="docs-table">
            <thead>
              <tr>
                <th>Status</th>
                <th>Meaning</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><code>400</code></td>
                <td>An id, <code>page</code> or <code>limit</code> isn't a whole number</td>
              </tr>
              <tr>
                <td><code>404</code></td>
                <td>No record with that id, or no such endpoint</td>
              </tr>
              <tr>
                <td><code>429</code></td>
                <td>Too many requests (see <a href="#rate-limits">Rate Limits</a>)</td>
              </tr>
              <tr>
                <td><code>500</code></td>
                <td>Something went wrong on the server. The body has a <code>message</code> field instead of <code>error</code>.</td>
              </tr>
            </tbody>
          </table>
        </section>

        <!-- Rate Limits -->
        <section id="rate-limits" class="docs-section">
          <h2>Rate Limits</h2>
          <p>
            Each IP address can make 100 requests per minute. Every response reports where you stand in the <code>RateLimit</code> and <code>RateLimit-Policy</code> headers:
          </p>
          <pre class="docs-json">RateLimit-Policy: 100;w=60
RateLimit: limit=100, remaining=99, reset=60</pre>
          <p>
            <code>reset</code> is the number of seconds until the count starts over. Past the limit, requests return <code>429</code> with a <code>Retry-After</code> header until the minute is up. To get everything at once, call a list endpoint without <code>page</code> and <code>limit</code>: one request returns the whole collection.
          </p>
        </section>

