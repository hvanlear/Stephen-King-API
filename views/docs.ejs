          </div>

          <!-- GET /api/type/:id -->
          <div class="endpoint-card">
            <div class="endpoint-header">
              <span class="endpoint-method">GET</span>
              <span class="endpoint-path">/api/type/:id</span>
            </div>
            <p>Returns a single type by ID. Id 5 is unused: the old database used it for groups, which are now the villain's <code>group</code> flag.</p>
            <h4>Example Request</h4>
            <div class="docs-code-block">
              <code>GET <%= url %>/api/type/16</code>
            </div>
            <h4>Example Response</h4>
            <pre class="docs-json">{
  "data": {
    "id": 16,
    "name": "North Central Positronics",
    "handle": "north-central-positronics",
    "created_at": "2026-10-30T00:54:07.000Z",
    "parent": {
      "name": "Machine or object",
      "url": "<%= url %>/api/type/6"
    },
    "types": [],
    "villains": [
      {
        "name": "Blaine the Mono",
        "url": "<%= url %>/api/villain/3"
      },
      {
        "name": "Andy",
        "url": "<%= url %>/api/villain/177"
      }
    ]
  }
}</pre>
          </div>
