              </tr>
              <tr>
                <td><code>status</code></td>
                <td>string</td>
                <td><code>"Deceased"</code> or <code>"Alive"</code></td>
              </tr>
              <tr>
                <td><code>types_id</code></td>
                <td>integer</td>
                <td>Id of the villain's broad type (see <code>type</code>)</td>
              </tr>
              <tr>
                <td><code>group</code></td>
                <td>boolean</td>
                <td>Whether the record is a set of villains, such as a gang, a cult or a race</td>
              </tr>
              <tr>
                <td><code>notes</code></td>
                <td>string[]</td>
                <td>Additional notes</td>
              </tr>
              <tr>
                <td><code>books</code></td>
                <td>array</td>
                <td>Associated books with title and URL</td>
              </tr>
              <tr>
                <td><code>shorts</code></td>
                <td>array</td>
                <td>Associated short stories with title and URL</td>
              </tr>
              <tr>
                <td><code>residence</code></td>
                <td>array</td>
                <td>Where the villain lives, with name and URL</td>
              </tr>
              <tr>
                <td><code>type</code></td>
                <td>object</td>
