    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="https://use.typekit.net/smb2swj.css" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Stephen King API</title>
  </head>
  <body>
    <%
      const resources = [
        { name: "Books", list: "books", one: "book", id: 19, count: counts.books },
        { name: "Short stories", list: "shorts", one: "short", id: 19, count: counts.shorts },
        { name: "Villains", list: "villains", one: "villain", id: 19, count: counts.villains },
        { name: "Places", list: "places", one: "place", id: 76, count: counts.places },
        { name: "Villain types", list: "types", one: "type", id: 2, count: counts.types },
        { name: "Collections", list: "collections", one: "collection", id: 1, count: counts.collections },
        { name: "Publications", list: "publications", one: "publication", id: 7, count: counts.publications },
      ];
    %>
    <div class="home">
      <header class="home-header">
        <a class="home-wordmark" href="/" aria-label="Stephen King API home">
          <span class="home-sk">Stephen King</span>
          <span class="home-sk-sub">The Api</span>
        </a>
        <div class="home-intro">
          <p>A free, read-only REST API of King's books, short stories, villains and the places they haunt. No key, just GET.</p>
          <a class="docs-link" href="/docs">View Documentation &rarr;</a>
        </div>
      </header>

      <main class="home-main">
        <nav class="home-endpoints" aria-label="Endpoints">
          <% resources.forEach((r) => { %>
            <section class="home-resource">
              <h2><%= r.name %> <span class="home-count"><%= r.count %></span></h2>
              <a class="home-endpoint" href="/api/<%= r.list %>" target="_blank"
                 data-path="/api/<%= r.list %>" data-preview="/api/<%= r.list %>?page=1&amp;limit=2">
                <code>GET /api/<%= r.list %></code>
              </a>
              <a class="home-endpoint<%= r.one === 'book' ? ' is-active' : '' %>" href="/api/<%= r.one %>/<%= r.id %>" target="_blank"
                 data-path="/api/<%= r.one %>/{id}" data-preview="/api/<%= r.one %>/<%= r.id %>"
                 <%= r.one === 'book' ? 'aria-current="true"' : '' %>>
                <code>GET /api/<%= r.one %>/{id}</code>
              </a>
            </section>
          <% }) %>
        </nav>

        <section class="home-example" aria-label="Example response">
          <div class="home-example-bar">
            <a id="example-url" class="home-example-url" href="/api/book/19" target="_blank"><span class="url"><%= url %></span><span class="bold" id="example-path">/api/book/19</span></a>
            <span id="example-status" class="home-example-status">200</span>
          </div>
          <pre id="example-body" class="home-example-body" aria-live="polite"><%= example %></pre>
          <p class="home-example-note">Lists return everything unless you pass <code>page</code> and <code>limit</code>; the examples here ask for two.</p>
        </section>
      </main>

      <footer class="footer">
          <a
            class="underline-link author"
            href="https://github.com/hvanlear"
            target="_blank"
            >Hunter Van Lear</a
          >
          <a
            class="footer-icon"
            href="https://github.com/hvanlear/Stephen-King-API"
            target="_blank"
            ><?xml version="1.0" encoding="UTF-8"?><svg
              width="20px"
              height="20px"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
              color="#828282"
            >
              <path
                d="M12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22Z"
                stroke="#828282"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
              <path
                d="M14.3333 19V17.137C14.3583 16.8275 14.3154 16.5163 14.2073 16.2242C14.0993 15.9321 13.9286 15.6657 13.7067 15.4428C15.8 15.2156 18 14.4431 18 10.8989C17.9998 9.99256 17.6418 9.12101 17 8.46461C17.3039 7.67171 17.2824 6.79528 16.94 6.01739C16.94 6.01739 16.1533 5.7902 14.3333 6.97811C12.8053 6.57488 11.1947 6.57488 9.66666 6.97811C7.84666 5.7902 7.05999 6.01739 7.05999 6.01739C6.71757 6.79528 6.69609 7.67171 6.99999 8.46461C6.35341 9.12588 5.99501 10.0053 5.99999 10.9183C5.99999 14.4366 8.19999 15.2091 10.2933 15.4622C10.074 15.6829 9.90483 15.9461 9.79686 16.2347C9.68889 16.5232 9.64453 16.8306 9.66666 17.137V19"
                stroke="#828282"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
              <path
                d="M9.66667 17.7018C7.66667 18.3335 6 17.7018 5 15.7544"
                stroke="#828282"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path></svg
          ></a>
          <script
            type="text/javascript"
            src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js"
            data-name="bmc-button"
            data-slug="hvanleare"
            data-color="#f6f0f0"
            data-emoji=""
            data-font="Poppins"
            data-text="Buy me a coffee"
            data-outline-color="#828282"
            data-font-color="#828282"
            data-coffee-color="#AE0F0E"
          ></script>
          <p class="data-credit">
            Data adapted from
            <a href="https://en.wikipedia.org/wiki/Stephen_King_bibliography" target="_blank">Wikipedia</a>
            and the
            <a href="https://stephenking.fandom.com" target="_blank">Stephen King Wiki</a>,
            licensed under
            <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank">CC BY-SA 4.0</a>.
          </p>
        </footer>

    </div>
    <script>
      (function () {
        var links = document.querySelectorAll(".home-endpoint");
        var urlEl = document.getElementById("example-url");
        var pathEl = document.getElementById("example-path");
        var statusEl = document.getElementById("example-status");
        var bodyEl = document.getElementById("example-body");
        var cache = {};

        function escape(s) {
          return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
        // Colours keys, strings, numbers and literals in pretty-printed JSON
        function highlight(json) {
          return escape(json).replace(
            /("(?:\\.|[^"\\])*")(\s*:)?|\b(true|false|null)\b|-?\d+(?:\.\d+)?/g,
            function (m, str, colon, lit) {
              if (str) return colon ? '<span class="j-key">' + str + "</span>" + colon : '<span class="j-str">' + str + "</span>";
              if (lit) return '<span class="j-lit">' + m + "</span>";
              return '<span class="j-num">' + m + "</span>";
            }
          );
        }
        function show(path, status, text) {
          pathEl.textContent = path;
          urlEl.href = path;
          statusEl.textContent = status;
          statusEl.classList.toggle("is-error", status >= 400);
          bodyEl.innerHTML = highlight(text);
          bodyEl.scrollTop = 0;
        }

        bodyEl.innerHTML = highlight(bodyEl.textContent);

        links.forEach(function (link) {
          link.addEventListener("click", function (e) {
            if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
            e.preventDefault();
            links.forEach(function (l) { l.classList.remove("is-active"); l.removeAttribute("aria-current"); });
            link.classList.add("is-active");
            link.setAttribute("aria-current", "true");
            var path = link.dataset.preview;
            // On a phone the example sits below the list, so bring it into view
            if (window.matchMedia("(max-width: 800px)").matches) {
              urlEl.parentNode.scrollIntoView({ behavior: "smooth", block: "start" });
            }
            if (cache[path]) return show(path, cache[path].status, cache[path].text);
            bodyEl.classList.add("is-loading");
            fetch(path)
              .then(function (res) {
                return res.json().then(function (body) {
                  return { status: res.status, text: JSON.stringify(body, null, 2) };
                });
              })
              .then(function (r) {
                if (r.status < 400) cache[path] = r;
                show(path, r.status, r.text);
              })
              .catch(function () {
                show(path, "—", "Couldn't reach the API. Try the link instead.");
              })
              .then(function () { bodyEl.classList.remove("is-loading"); });
          });
        });
      })();
    </script>
  </body>
</html>
